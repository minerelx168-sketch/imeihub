# imeihub Docker dev template.
#
# Copy to .env and fill in IMEI_API_KEY before the first `docker compose up`.
# The DB_* + APP_URL values are overridden by docker-compose.yml so you
# don't have to edit them here.
#
#   cp .env.docker .env
#   # edit .env, paste your IMEI_API_KEY
#   docker compose up --build -d
#   open http://localhost:8080
#   sign in: test@example.com / test123  ($100 credit pre-seeded)

# ----- App -----
APP_NAME="imeihub"
APP_URL=http://localhost:8080
APP_DEBUG=true

# ----- Database (overridden by compose; leave as-is) -----
DB_HOST=db
DB_NAME=imei_checker
DB_USER=root
DB_PASS=devpassword

# ----- IMEI provider -----
# Default "demo": an offline simulator returning realistic device data
# with no external API call or key, so the homepage check works the
# moment the stack is up. For live lookups, switch to a real provider:
#   IMEI_API_PROVIDER=unlock-service
#   IMEI_API_KEY=<your unlock-service.net key>
#   IMEI_API_USERNAME=<only needed for DHRU async services>
# The PHP API needs only the key; the DHRU async API also needs username.
IMEI_API_PROVIDER=demo
IMEI_API_KEY=replace-with-your-unlock-service-key
IMEI_API_USERNAME=
IMEI_API_URL=https://api.unlock-service.net
IMEI_API_DEFAULT_SERVICE=1

# ----- Session -----
SESSION_LIFETIME_DAYS=30
SESSION_COOKIE_NAME=imeihub_sid

# ----- Optional integrations (leave empty to disable) -----
# Email signup OTP - if RESEND_API_KEY is blank, signups fall back to
# the seeded test user only. (Resend free tier works fine for dev.)
RESEND_API_KEY=
RESEND_FROM="imeihub <noreply@imeihub.net>"

# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe - sk_test_ for sandbox. Webhook needs a public HTTPS URL
# (use `ngrok http 8080` or similar to expose localhost).
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal - https://developer.paypal.com/dashboard/applications
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Binance Pay - https://merchant.binance.com
BINANCE_PAY_KEY=
BINANCE_PAY_SECRET=

# Telegram / LINE bots - skip for the dev container.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
